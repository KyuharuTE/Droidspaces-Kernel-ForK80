# Droidspaces kernel options for GKI (kABI-safe set)
# Kernel: 6.1.157-android14-6.1  |  Droidspaces-OSS, GPL-3.0-or-later
#
# These options are only kABI-safe when the matching kABI patch has been
# applied (see patches/). Without it the device bootloops the moment
# CONFIG_SYSVIPC is enabled, because it shifts offsets in task_struct and
# the prebuilt vendor modules (GPU, camera) then dereference garbage.
#
# Do not enable anything beyond this list.

# IPC. This is the one that needs the SYSVIPC kABI patch.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces.
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Device filesystem. Droidspaces sets up /dev from this.
CONFIG_DEVTMPFS=y

# Enhanced NAT support.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Optional but recommended below here.

# Fixes the "unsafe procfs" error when running Docker inside a container.
CONFIG_USER_NS=y

# UFW support.
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support.
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# xattr and POSIX ACL on tmpfs, needed for NixOS.
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y


# Module signing off.
#
# Two things matter here and both are about the stock vendor modules, not about
# our own build. CONFIG_MODULE_SIG_PROTECT turns on GKI's protected-exports
# allowlist: a module that accesses a symbol outside the list generated from this
# build is refused with -EACCES, even when its signature is fine. That list is
# derived from the config, so a kernel built with a different config than stock
# produces a different list and the vendor modules stop loading, which reads as a
# bootloop with no obvious cause.
#
# MODULE_SIG_PROTECT depends on MODULE_SIG, so turning MODULE_SIG off removes the
# allowlist as well. certs/extract-cert.c also does not build against OpenSSL 3.x
# without a source fix, so this keeps the build away from that path entirely.
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_PROTECT=n