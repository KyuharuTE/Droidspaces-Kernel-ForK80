# Shell scripts must stay LF. These files are authored on Windows and executed
# on a Linux runner; CRLF makes bash fail on the shebang with
# "/usr/bin/env: 'bash\r': No such file or directory", which looks like a
# missing interpreter rather than a line-ending problem.
*.sh text eol=lf
*.config text eol=lf
*.patch text eol=lf
*.yml text eol=lf

# Binary-ish.
*.png binary
*.jpg binary
*.zip binary
